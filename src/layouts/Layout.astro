---
import '../styles/global.css';
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/600-italic.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = 'TKonsulting — Stratégie · Projets · Image de Marque',
  description = 'Cabinet de conseil en stratégie, pilotage de projets complexes et transformation digitale. Piloter vos projets. Transformer vos idées. Automatiser votre succès.',
  image = '/og-image.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={image} />
    <meta property="og:type"        content="website" />
    <meta property="og:locale"      content="fr_FR" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts auto-hébergées (RGPD — aucun appel Google) -->

    <title>{title}</title>

    <style is:global>
      /* Global resets */
      *, *::before, *::after { box-sizing: border-box; }

      html { font-family: 'Inter', system-ui, sans-serif; background: #FEFCF8; color: #1A1714; }

      /* Accent text — degrade sobre, sans effet miroir */
      .text-gold-grad {
        background: linear-gradient(135deg, #82A2C4 0%, #5B7FA6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      /* Ancienne classe shimmer conservee pour compat, sans animation clinquante */
      .shimmer {
        color: #82A2C4;
      }

      /* Section reveal on scroll */
      .reveal {
        opacity: 0;
        transform: translateY(32px);
        transition: opacity 0.7s ease, transform 0.7s ease;
      }
      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* Trait de soulignement sobre */
      .gold-line::after {
        content: '';
        display: block;
        width: 60px;
        height: 2px;
        background: #5B7FA6;
        margin-top: 16px;
      }

      /* Bouton principal — couleur pleine, pas de degrade anime ni d'effet neon */
      .btn-gold {
        display: inline-flex; align-items: center; gap: 10px;
        padding: 17px 44px;
        background: #5B7FA6;
        color: #FEFCF8;
        font-family: 'Inter', sans-serif;
        font-weight: 700;
        font-size: 0.875rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        border: none;
        cursor: pointer;
        transition: background-color 0.25s ease, transform 0.2s ease;
        text-decoration: none;
      }
      .btn-gold:hover {
        background: #82A2C4;
        transform: translateY(-2px);
      }

      .btn-outline {
        display: inline-flex; align-items: center; gap: 10px;
        padding: 16px 40px;
        background: transparent;
        color: #82A2C4;
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        font-size: 0.875rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border: 1px solid rgba(130,162,196,0.5);
        cursor: pointer;
        transition: border-color 0.3s ease, color 0.3s ease, background 0.3s ease;
        text-decoration: none;
      }
      .btn-outline:hover {
        border-color: #82A2C4;
        color: #fff;
        background: rgba(91,127,166,0.08);
        transform: translateY(-2px);
      }

      /* Variante texte sombre — pour les boutons outline sur fond clair */
      .btn-outline-dark {
        display: inline-flex; align-items: center; gap: 10px;
        padding: 16px 40px;
        background: transparent;
        color: #1A1714;
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        font-size: 0.875rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border: 1px solid rgba(26,23,20,0.25);
        cursor: pointer;
        transition: border-color 0.3s ease, color 0.3s ease, background 0.3s ease, transform 0.2s ease;
        text-decoration: none;
      }
      .btn-outline-dark:hover {
        border-color: #5B7FA6;
        color: #5B7FA6;
        background: rgba(91,127,166,0.06);
        transform: translateY(-2px);
      }

      /* Card glass effect — surface claire, ombre douce plutot que halo */
      .card-glass {
        background: rgba(255,255,255,0.9);
        border: 1px solid #E8E2D6;
        backdrop-filter: blur(8px);
        box-shadow: 0 1px 3px rgba(26,23,20,0.04);
        transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
      }
      .card-glass:hover {
        border-color: rgba(91,127,166,0.4);
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(26,23,20,0.08);
      }

      /* Variante sombre — reservee aux sections volontairement nocturnes (Hero, vitrine projets) */
      .card-glass-dark {
        background: rgba(20,27,43,0.8);
        border: 1px solid rgba(91,127,166,0.14);
        backdrop-filter: blur(8px);
        transition: border-color 0.3s ease, transform 0.3s ease;
      }
      .card-glass-dark:hover {
        border-color: rgba(91,127,166,0.4);
        transform: translateY(-4px);
      }

      /* Sections alternees — cree du rythme sans rupture de teinte */
      .section-light {
        background: #F9F5EE;
      }

      /* Scrollbar */
      ::-webkit-scrollbar { width: 6px; }
      ::-webkit-scrollbar-track { background: #FEFCF8; }
      ::-webkit-scrollbar-thumb { background: #5B7FA644; border-radius: 3px; }
    </style>
  </head>
  <body class="bg-tk-black text-tk-text antialiased">
    <slot />

    <script>
      // Intersection observer for reveal animations
      const reveals = document.querySelectorAll('.reveal');
      const io = new IntersectionObserver(
        (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } }),
        { threshold: 0.12 }
      );
      reveals.forEach(el => io.observe(el));
    </script>
  </body>
</html>
